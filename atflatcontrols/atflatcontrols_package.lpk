<?xml version="1.0" encoding="UTF-8"?>
<CONFIG>
  <Package Version="6">
    <PathDelim Value="\"/>
    <Name Value="atflatcontrols_package"/>
    <Type Value="RunAndDesignTime"/>
    <Author Value="Alexey Torgashin"/>
    <CompilerOptions>
      <Version Value="11"/>
      <PathDelim Value="\"/>
      <SearchPaths>
        <IncludeFiles Value="res"/>
        <UnitOutputDirectory Value="lib\$(TargetCPU)-$(TargetOS)\$(LCLWidgetType)"/>
      </SearchPaths>
      <Parsing>
        <SyntaxOptions>
          <IncludeAssertionCode Value="True"/>
        </SyntaxOptions>
      </Parsing>
      <CodeGeneration>
        <Checks>
          <RangeChecks Value="True"/>
          <OverflowChecks Value="True"/>
        </Checks>
      </CodeGeneration>
      <Linking>
        <Debugging>
          <DebugInfoType Value="dsDwarf2Set"/>
        </Debugging>
      </Linking>
    </CompilerOptions>
    <Description Value="Custom-drawn controls, used in CudaText:
- ATTabs
- ATGroups
- ATButton
- ATFlatToolbar
- ATGauge
- ATListbox
- ATScrollbar
- ATStatusbar
and several simple controls."/>
    <License Value="MPL 2.0, LGPL"/>
    <Version Major="2" Minor="3" Release="1"/>
    <Files>
      <Item>
        <Filename Value="atbuttons.pas"/>
        <UnitName Value="ATButtons"/>
      </Item>
      <Item>
        <Filename Value="atflatcontrols_register.pas"/>
        <HasRegisterProc Value="True"/>
        <UnitName Value="atflatcontrols_register"/>
      </Item>
      <Item>
        <Filename Value="atlistbox.pas"/>
        <UnitName Value="ATListbox"/>
      </Item>
      <Item>
        <Filename Value="atlinklabel.pas"/>
        <UnitName Value="ATLinkLabel"/>
      </Item>
      <Item>
        <Filename Value="atflattoolbar.pas"/>
        <UnitName Value="ATFlatToolbar"/>
      </Item>
      <Item>
        <Filename Value="atpanelsimple.pas"/>
        <UnitName Value="ATPanelSimple"/>
      </Item>
      <Item>
        <Filename Value="atpanelcolor.pas"/>
        <UnitName Value="ATPanelColor"/>
      </Item>
      <Item>
        <Filename Value="atscrollbar.pas"/>
        <UnitName Value="ATScrollBar"/>
      </Item>
      <Item>
        <Filename Value="atstatusbar.pas"/>
        <UnitName Value="ATStatusBar"/>
      </Item>
      <Item>
        <Filename Value="atgauge.pas"/>
        <UnitName Value="ATGauge"/>
      </Item>
      <Item>
        <Filename Value="atflatthemes.pas"/>
        <UnitName Value="ATFlatThemes"/>
      </Item>
      <Item>
        <Filename Value="res\icons.lrs"/>
        <Type Value="LRS"/>
      </Item>
      <Item>
        <Filename Value="atgroups.pas"/>
        <UnitName Value="ATGroups"/>
      </Item>
      <Item>
        <Filename Value="attabs.pas"/>
        <UnitName Value="attabs"/>
      </Item>
      <Item>
        <Filename Value="atcanvasprimitives.pas"/>
        <UnitName Value="ATCanvasPrimitives"/>
      </Item>
    </Files>
    <RequiredPkgs>
      <Item>
        <PackageName Value="LCL"/>
      </Item>
    </RequiredPkgs>
    <UsageOptions>
      <UnitPath Value="$(PkgOutDir)"/>
    </UsageOptions>
    <PublishOptions>
      <Version Value="2"/>
    </PublishOptions>
    <CustomOptions Items="ExternHelp" Version="2">
      <_ExternHelp Items="Count"/>
    </CustomOptions>
  </Package>
</CONFIG>
